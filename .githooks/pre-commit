#!/bin/sh
# Prüft gestagte Änderungen mit gitleaks. Bei einem Fund bricht der Commit ab.
# Nicht mit git commit --no-verify umgehen.
set -e
cd "$(git rev-parse --show-toplevel)"
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "gitleaks fehlt. Commit abgebrochen." >&2
  echo "Installation: https://github.com/gitleaks/gitleaks/releases/tag/v8.30.1" >&2
  echo "Danach: git config core.hooksPath .githooks" >&2
  exit 1
fi
gitleaks protect --staged --config .gitleaks.toml --redact --verbose
