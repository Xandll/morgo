<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Home Assistant im LAN spricht oft http://192.168.x.x.
         Android blockiert Klartext sonst. HTTPS bleibt für öffentliche Server nutzbar. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
