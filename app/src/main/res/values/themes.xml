<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Morgo" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">#FFF6EE</item>
    </style>

    <style name="Theme.Morgo.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#F9A86B</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Morgo</item>
    </style>
</resources>
